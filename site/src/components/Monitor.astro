---
/**
 * One service: what it is, how it is, and how it has been.
 *
 * The state is written as a word at the right as well as coloured, because a
 * page whose only signal is colour is a page a colour-blind reader cannot use
 * — and this is the page they will be reading precisely when something is
 * wrong and they are in a hurry.
 *
 * data-monitor is what the live correction finds the row by; keep it.
 */

import type { Day, MonitorSummary } from "../lib/api"
import { availability } from "../lib/api"
import Bars from "./Bars.astro"

interface Props {
    monitor: MonitorSummary
    days: Day[]
}

const { monitor, days } = Astro.props

const WORDS: Record<string, string> = {
    up: "Operational",
    degraded: "Degraded",
    down: "Outage",
    unknown: "No data",
}

const share = availability(days)
const window = days.length
---

<article class="monitor" data-monitor={monitor.id}>
    <header>
        <div class="what">
            <h3>
                {monitor.name}
                {monitor.ms !== null && <span class="ms">{monitor.ms} ms</span>}
            </h3>
            {monitor.description && <p>{monitor.description}</p>}
        </div>
        <span class:list={["state", monitor.state]}>{WORDS[monitor.state]}</span>
    </header>

    <Bars days={days} label={`${monitor.name}: the last ${window} days`} />

    <footer>
        <span>{window} days ago</span>
        <span class="share">
            {share === null ? "No data yet" : `${share.toFixed(2)}% available`}
        </span>
        <span>Today</span>
    </footer>
</article>

<style>
    .monitor + .monitor {
        margin-top: 28px;
        padding-top: 28px;
        /* The one line on the page. Rows of services need separating and a gap
           alone does not do it once the strips are all the same length. */
        border-top: 1px solid var(--perch-surface-high);
    }

    header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
    }

    h3 {
        font-size: 15px;
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .ms {
        color: var(--perch-fg-dim);
        font-size: 13px;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
    }

    .what p {
        margin-top: 2px;
        color: var(--perch-fg-dim);
        font-size: 13px;
    }

    .state {
        flex: none;
        font-size: 13px;
        font-weight: 550;
        color: var(--perch-fg-muted);
    }

    .state.up {
        color: var(--perch-up);
    }

    .state.degraded {
        color: var(--perch-degraded);
    }

    .state.down {
        color: var(--perch-down);
    }

    footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 8px;
        color: var(--perch-fg-dim);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    /* The number in the middle is the one worth reading; the two dates are
       there to say what the strip spans. */
    .share {
        color: var(--perch-fg-muted);
    }

    @media (max-width: 600px) {
        header {
            flex-direction: column;
            gap: 4px;
        }
    }
</style>
