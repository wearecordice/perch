---
/**
 * One incident, in full.
 *
 * The timeline is the page. A reader who arrives here already knows something
 * broke; what they want is when it was noticed, what it turned out to be, and
 * whether it is over — in that order, which is the order it was written in.
 */

import { getCollection, render } from "astro:content"
import "../../styles/theme.css"
import Icon from "../../components/Icon.astro"
import { outcome, severityState } from "../../lib/incidents"

export async function getStaticPaths() {
    const incidents = await getCollection("incidents")
    return incidents.map((incident) => ({
        params: { id: incident.id },
        props: { incident },
    }))
}

const { incident } = Astro.props
const { Content } = await render(incident)

const SEVERITY: Record<string, string> = {
    degraded: "Degraded performance",
    partial: "Partial outage",
    major: "Major outage",
    maintenance: "Scheduled maintenance",
}

const STATE: Record<string, string> = {
    investigating: "Investigating",
    identified: "Identified",
    monitoring: "Monitoring",
    resolved: "Resolved",
}

const when = (date: Date) =>
    date.toLocaleString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "UTC",
    }) + " UTC"
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{incident.data.title} — Status</title>
        <meta name="description" content={SEVERITY[incident.data.severity]} />
    </head>
    <body>
        <main>
            <a class="back" href="/">← All systems</a>

            <header class="head">
                <p class="severity">
                    <Icon state={severityState(incident.data.severity)} size={18} />
                    {SEVERITY[incident.data.severity]}
                </p>
                <h1>{incident.data.title}</h1>
                <p class="when">
                    Began {when(incident.data.started)} · {outcome(incident)}
                </p>
                {
                    incident.data.affected.length > 0 && (
                        <p class="affected">
                            Affected: {incident.data.affected.join(", ")}
                        </p>
                    )
                }
            </header>

            <ol class="timeline">
                {
                    incident.data.updates.map((update) => (
                        <li>
                            <span class:list={["tag", update.state]}>
                                {STATE[update.state]}
                            </span>
                            <div>
                                <time datetime={update.at.toISOString()}>
                                    {when(update.at)}
                                </time>
                                <p>{update.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>

            <div class="prose"><Content /></div>
        </main>

        <style>
            main {
                max-width: 720px;
                margin: 0 auto;
                padding: 56px 24px 96px;
            }

            .back {
                display: inline-block;
                margin-bottom: 32px;
                color: var(--perch-fg-dim);
                font-size: 14px;
            }

            .back:hover {
                color: var(--perch-fg-muted);
            }

            .severity {
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--perch-fg-muted);
                font-size: 13px;
                font-weight: 550;
            }

            h1 {
                margin-top: 10px;
                font-size: clamp(1.5rem, 3.5vw, 2rem);
                letter-spacing: -0.03em;
            }

            .when,
            .affected {
                margin-top: 8px;
                color: var(--perch-fg-dim);
                font-size: 14px;
            }

            /* The timeline. Newest last, because it is read as a story and a
               story that starts at the end is a spoiler. */
            .timeline {
                list-style: none;
                margin: 36px 0 0;
                padding: 0;
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .timeline li {
                display: flex;
                gap: 14px;
                align-items: flex-start;
                background: var(--perch-surface);
                border-radius: var(--perch-radius);
                padding: 16px 18px;
            }

            .tag {
                flex: none;
                padding: 3px 10px;
                border-radius: var(--perch-radius-full);
                background: var(--perch-surface-high);
                color: var(--perch-fg-muted);
                font-size: 12px;
                font-weight: 600;
            }

            .tag.resolved {
                background: var(--perch-up);
                color: var(--perch-bg);
            }

            .timeline time {
                display: block;
                color: var(--perch-fg-dim);
                font-size: 12px;
            }

            .timeline p {
                margin-top: 4px;
                color: var(--perch-fg-muted);
                font-size: 14px;
            }

            .prose {
                margin-top: 28px;
                color: var(--perch-fg-dim);
                font-size: 14px;
            }
        </style>
    </body>
</html>
