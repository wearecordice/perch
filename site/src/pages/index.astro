---
/**
 * The status page.
 *
 * Built as static HTML and then corrected by the browser: the page ships with
 * whatever the last build knew and asks Perch for the current readings once it
 * has loaded. That way it is fast, it can be served from anywhere, and it is
 * never more than a minute out of date without needing a deployment to say so.
 *
 * Incidents are the other half and work the other way round: they are files in
 * this repository, rendered at build time. A monitor can say a thing stopped
 * answering; only a person can say why.
 */

import { getCollection } from "astro:content"
import "../styles/theme.css"
import Icon from "../components/Icon.astro"
import Monitor from "../components/Monitor.astro"
import { overall, sampleDays, sampleMonitors } from "../lib/api"
import { outcome, severityState } from "../lib/incidents"

const monitors = sampleMonitors()
const days = Object.fromEntries(monitors.map((m) => [m.id, sampleDays(m.id)]))
const state = overall(monitors)

const incidents = (await getCollection("incidents")).sort(
    (a, b) => b.data.started.getTime() - a.data.started.getTime(),
)

const HEADLINE: Record<string, string> = {
    up: "All systems operational",
    degraded: "Some services are degraded",
    down: "Major outage",
    unknown: "Status unavailable",
}

const BANNER_ICON = {
    up: "up",
    degraded: "degraded",
    down: "major",
    unknown: "unknown",
} as const

/**
 * The two lines anyone forking this changes first.
 *
 * The API is a path, not a host: the page is served by the same worker that
 * answers it. Point this at an origin if you host the two apart.
 */
const site = { name: "Cordice", api: "" }

/* Handed to the browser so an opened day can list what was happening on it
   without another request. Dates as ISO strings, which is what a bar carries. */
const incidentData = incidents.map((incident) => ({
    id: incident.id,
    title: incident.data.title,
    state: severityState(incident.data.severity),
    affected: incident.data.affected,
    from: incident.data.started.toISOString().slice(0, 10),
    to: (incident.data.resolved ?? new Date()).toISOString().slice(0, 10),
    outcome: outcome(incident),
}))
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{site.name} Status</title>
        <meta
            name="description"
            content={`Whether ${site.name} is working, checked from outside its own infrastructure.`}
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${site.name} Status`}
            href="/feed.xml"
        />
        <link
            rel="alternate"
            type="application/atom+xml"
            title={`${site.name} Status`}
            href="/atom.xml"
        />
    </head>
    <body>
        <main>
            <section class="banner">
                <span class="mark" data-mark>
                    <Icon state={BANNER_ICON[state]} size={44} />
                </span>
                <h1 data-headline>{HEADLINE[state]}</h1>
                <p class="when" data-when>Checking…</p>
            </section>

            <section class="panel">
                <header class="panel-head">
                    <h2>System status</h2>
                    <span class="window">Last 90 days</span>
                </header>

                {
                    monitors.map((monitor) => (
                        <Monitor
                            monitor={monitor}
                            days={days[monitor.id] ?? []}
                            incidents={incidents}
                        />
                    ))
                }
            </section>

            <p class="sample" data-sample>
                Showing sample data — no reading has been received yet.
            </p>

            <section class="panel">
                <header class="panel-head">
                    <h2>Past incidents</h2>
                    <span class="window">Written by hand</span>
                </header>

                {
                    incidents.length === 0 ? (
                        <p class="none">Nothing has gone wrong yet.</p>
                    ) : (
                        <ul class="incident-list">
                            {incidents.slice(0, 10).map((incident) => (
                                <li>
                                    <Icon
                                        state={severityState(incident.data.severity)}
                                        size={18}
                                    />
                                    <div>
                                        <a href={`/incidents/${incident.id}/`}>
                                            {incident.data.title}
                                        </a>
                                        <p>
                                            {incident.data.started.toLocaleDateString(
                                                "en-GB",
                                                {
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric",
                                                },
                                            )}
                                            {" · "}
                                            {outcome(incident)}
                                        </p>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </section>

            <footer class="foot">
                <span>
                    Subscribe: <a href="/feed.xml">RSS</a> ·
                    <a href="/atom.xml">Atom</a>
                </span>
                <span>
                    Watched by <a href="https://github.com/wearecordice/perch">Perch</a>
                </span>
            </footer>
        </main>

        <script is:inline define:vars={{ api: site.api, incidents: incidentData }}>
            /* Two jobs: correct the page from the live worker, and open a day
             * when a bar is clicked.
             *
             * Everything either touches was already rendered, so a failure
             * leaves the page as built rather than empty — and the sample
             * notice stays up, which is the honest outcome when we cannot
             * reach our own monitor. */
            const HEADLINES = {
                up: "All systems operational",
                degraded: "Some services are degraded",
                down: "Major outage",
                unknown: "Status unavailable",
            }
            const WORDS = {
                up: "Operational",
                degraded: "Degraded",
                down: "Outage",
                unknown: "No data",
            }
            const HIGHEST = {
                up: "Operational",
                degraded: "Degraded performance",
                down: "Major outage",
                maintenance: "Maintenance",
                unknown: "No data",
            }
            const ORDER = ["up", "degraded", "down"]
            const RANK = ["unknown", "up", "maintenance", "degraded", "down"]

            /** Seconds between checks. Corrected by the worker's own answer. */
            let interval = 300

            fetch(api + "/api/summary")
                .then((r) => (r.ok ? r.json() : Promise.reject()))
                .then((data) => {
                    const known = data.monitors
                        .map((m) => m.state)
                        .filter((s) => ORDER.includes(s))
                    const worst = known.length
                        ? known.reduce((a, b) =>
                              ORDER.indexOf(b) > ORDER.indexOf(a) ? b : a,
                          )
                        : "unknown"

                    paint(document.querySelector("[data-mark] svg"), worst)
                    document.querySelector("[data-headline]").textContent =
                        HEADLINES[worst]

                    const newest = Math.max(0, ...data.monitors.map((m) => m.at || 0))
                    document.querySelector("[data-when]").textContent = newest
                        ? "Last updated on " + new Date(newest * 1000).toLocaleString()
                        : "No reading yet"

                    for (const monitor of data.monitors) {
                        const row = document.querySelector(
                            '[data-monitor="' + monitor.id + '"]',
                        )
                        if (!row) continue

                        const state = row.querySelector(".state")
                        state.className = "state " + monitor.state
                        state.textContent = WORDS[monitor.state]

                        const ms = row.querySelector(".ms")
                        if (ms && monitor.ms !== null) ms.textContent = monitor.ms + " ms"
                    }

                    return fetch(api + "/api/history")
                })
                .then((r) => (r.ok ? r.json() : Promise.reject()))
                .then((data) => {
                    if (data.interval) interval = data.interval

                    /* The strips are redrawn from real days, or the notice
                       stays. Leaving invented history under live readings
                       would be the page's own first lie. */
                    for (const [id, days] of Object.entries(data.monitors)) {
                        const row = document.querySelector('[data-monitor="' + id + '"]')
                        if (row) redraw(row, id, days, data.days)
                    }
                    document.querySelector("[data-sample]")?.remove()
                })
                .catch(() => {})

            /** An icon's state lives in its class; swap it rather than redraw. */
            function paint(icon, state) {
                if (!icon) return
                const shape = state === "down" ? "major" : state
                icon.classList.remove("up", "degraded", "major", "maintenance", "unknown")
                icon.classList.add(shape)
            }

            /** Rebuilds one strip, padding the window so today is at the right. */
            function redraw(row, id, days, window) {
                const bars = row.querySelector("[data-bars]")
                if (!bars) return

                const byDay = new Map(days.map((d) => [d.day, d]))
                /* Cloned rather than created: Astro scopes its styles with a
                   data attribute, and an element built from scratch carries
                   none of it — the first version drew ninety invisible bars. */
                const template = bars.firstElementChild
                if (!template) return

                bars.replaceChildren(
                    ...Array.from({ length: window }, (_, i) => {
                        const date = new Date(Date.now() - (window - 1 - i) * 86400000)
                            .toISOString()
                            .slice(0, 10)
                        const day = byDay.get(date) || {
                            up: 0,
                            degraded: 0,
                            down: 0,
                            ms: null,
                        }
                        const bar = template.cloneNode(false)
                        bar.classList.remove("up", "degraded", "down", "maintenance")
                        bar.classList.add(stateOf(id, date, day))
                        bar.dataset.day = date
                        bar.dataset.up = day.up
                        bar.dataset.degraded = day.degraded
                        bar.dataset.down = day.down
                        bar.dataset.ms = day.ms ?? ""
                        bar.setAttribute("aria-label", date + " — see this day")
                        bar.removeAttribute("aria-expanded")
                        bar.removeAttribute("data-showing")
                        bar.removeAttribute("data-pinned")
                        return bar
                    }),
                )

                const total = days.reduce((n, d) => n + d.up + d.degraded + d.down, 0)
                const bad = days.reduce((n, d) => n + d.down, 0)
                const share = row.querySelector(".share")
                if (share) {
                    share.textContent = total
                        ? (((total - bad) / total) * 100).toFixed(2) + "% available"
                        : "No data yet"
                }
            }

            /** Measured state, unless a written incident says worse. */
            function stateOf(id, date, day) {
                const checks = day.up + day.degraded + day.down
                let state = !checks
                    ? "unknown"
                    : day.down
                      ? "down"
                      : day.degraded
                        ? "degraded"
                        : "up"

                for (const incident of onDay(id, date)) {
                    if (RANK.indexOf(incident.state) > RANK.indexOf(state)) {
                        state = incident.state
                    }
                }
                return state
            }

            const onDay = (id, date) =>
                incidents.filter(
                    (i) => i.affected.includes(id) && date >= i.from && date <= i.to,
                )

            /* Opening a day. One panel per service, reused by all its bars.
             *
             * Pointing at a bar shows it and clicking pins it there. Hover
             * alone would be no good — the panel carries links, and reaching
             * for one would take the pointer off the bar that summoned it. A
             * click alone is worse: ninety days is a lot to click through to
             * find out that eighty-nine of them are dull. So the preview
             * follows the pointer and survives anywhere inside the service's
             * own row, and a click nails it down until you click again.
             *
             * data-showing is the day the panel is displaying; data-pinned is
             * the one it returns to when the pointer wanders off.
             * aria-expanded stays truthful about whether the panel is open, so
             * a screen reader hears a disclosure rather than a mystery. */
            const rowOf = (element) => element.closest("[data-monitor]")

            function show(row, bar) {
                const panel = row.querySelector("[data-day-panel]")
                clear(row)
                bar.setAttribute("data-showing", "")
                bar.setAttribute("aria-expanded", "true")
                fill(panel, row.dataset.monitor, bar.dataset)
                panel.hidden = false
            }

            function clear(row) {
                row.querySelectorAll(".bar[data-showing]").forEach((b) => {
                    b.removeAttribute("data-showing")
                    b.removeAttribute("aria-expanded")
                })
            }

            /* Back to the pinned day, or to nothing if none was pinned. */
            function restore(row) {
                const pinned = row.querySelector(".bar[data-pinned]")
                if (pinned) {
                    show(row, pinned)
                    return
                }
                clear(row)
                row.querySelector("[data-day-panel]").hidden = true
                row.querySelectorAll(".incidents li[data-in-panel]").forEach((item) =>
                    item.removeAttribute("data-in-panel"),
                )
            }

            const preview = (event) => {
                const bar = event.target.closest?.("[data-bars] .bar")
                if (bar) show(rowOf(bar), bar)
            }

            const leave = (event) => {
                const row = event.target.closest?.("[data-monitor]")
                if (!row || row.contains(event.relatedTarget)) return
                restore(row)
            }

            document.addEventListener("pointerover", preview)
            document.addEventListener("pointerout", leave)
            /* Keyboard gets the same thing: a focused bar is a pointed-at one. */
            document.addEventListener("focusin", preview)
            document.addEventListener("focusout", leave)

            document.addEventListener("click", (event) => {
                const bar = event.target.closest("[data-bars] .bar")
                if (!bar) return

                const row = rowOf(bar)
                const wasPinned = bar.hasAttribute("data-pinned")

                row.querySelectorAll(".bar[data-pinned]").forEach((b) =>
                    b.removeAttribute("data-pinned"),
                )

                /* Clicking the pinned day unpins it but leaves it on screen —
                   the pointer is still on that bar, and yanking the panel away
                   from under it would read as a fault rather than a choice. */
                if (!wasPinned) bar.setAttribute("data-pinned", "")
                show(row, bar)
            })

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return
                document.querySelectorAll(".bar[data-pinned]").forEach((bar) => {
                    bar.removeAttribute("data-pinned")
                    const row = rowOf(bar)
                    clear(row)
                    row.querySelector("[data-day-panel]").hidden = true
                })
            })

            function fill(panel, id, data) {
                const up = Number(data.up || 0)
                const degraded = Number(data.degraded || 0)
                const down = Number(data.down || 0)
                const checks = up + degraded + down

                /* The same rule the bar above it follows: a day carrying a
                   written incident is not reported as fine merely because the
                   monitor was happy through it. Without this the strip and
                   the panel it opens contradict each other, and the panel is
                   the one the reader believes. */
                const state = stateOf(id, data.day, {
                    up: up,
                    degraded: degraded,
                    down: down,
                })

                const field = (name) =>
                    panel.querySelector('[data-field="' + name + '"]')

                field("date").textContent = new Date(
                    data.day + "T00:00:00Z",
                ).toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "short",
                    year: "numeric",
                    timeZone: "UTC",
                })

                /* Downtime is failed checks times the gap between them: the
                   worst it could have been, and the only honest reading from
                   sampling. A day nobody measured says so instead of "none". */
                field("downtime").textContent = !checks
                    ? "Not measured"
                    : down === 0
                      ? "None"
                      : humanise(down * interval)

                field("availability").textContent = !checks
                    ? "—"
                    : (((checks - down) / checks) * 100).toFixed(4) + "%"

                const highest = field("highest")
                highest.textContent = HIGHEST[state]
                paint(highest.parentElement.querySelector("svg"), state)

                const list = field("incidents")
                const shown = onDay(id, data.day)

                /* An incident named in the panel is struck from the service's
                   own list underneath it, so the same sentence is never
                   printed twice, one line apart. Sweeping the strip moves the
                   line between the two lists rather than duplicating it. */
                const own = panel.closest("[data-monitor]").querySelectorAll(".incidents li[data-incident]")
                own.forEach((item) =>
                    item.toggleAttribute(
                        "data-in-panel",
                        shown.some((i) => i.id === item.dataset.incident),
                    ),
                )

                list.replaceChildren(
                    ...shown.map((incident) => {
                        const row = document.createElement("div")
                        row.className = "row"

                        const link = document.createElement("a")
                        link.href = "/incidents/" + incident.id + "/"
                        link.textContent = incident.title

                        const leader = document.createElement("span")
                        leader.className = "leader"

                        const out = document.createElement("span")
                        out.className = "outcome"
                        out.textContent = incident.outcome

                        row.append(link, leader, out)
                        return row
                    }),
                )
            }

            function humanise(seconds) {
                const minutes = Math.round(seconds / 60)
                if (minutes < 60)
                    return minutes + (minutes === 1 ? " minute" : " minutes")
                const hours = Math.floor(minutes / 60)
                const rest = minutes % 60
                return (
                    hours +
                    (hours === 1 ? " hour" : " hours") +
                    (rest ? " " + rest + " minutes" : "")
                )
            }
        </script>

        <style>
            main {
                max-width: var(--perch-measure);
                margin: 0 auto;
                padding: 72px 24px 96px;
            }

            /* The banner. The one thing a reader came for, and the only place
               on the page where type is allowed to be large. */
            .banner {
                text-align: center;
                margin-bottom: 56px;
            }

            .mark {
                display: block;
                width: 44px;
                margin: 0 auto 20px;
            }

            h1 {
                font-size: clamp(1.75rem, 4vw, 2.25rem);
                letter-spacing: -0.03em;
            }

            .when {
                margin-top: 10px;
                color: var(--perch-fg-dim);
                font-size: 14px;
            }

            .panel {
                background: var(--perch-surface);
                border-radius: var(--perch-radius);
                padding: 24px;
            }

            .panel + .panel {
                margin-top: 24px;
            }

            .panel-head {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 24px;
            }

            h2 {
                font-size: 16px;
            }

            .window {
                color: var(--perch-fg-dim);
                font-size: 13px;
            }

            .sample {
                margin: 20px 0;
                text-align: center;
                color: var(--perch-fg-dim);
                font-size: 13px;
            }

            .incident-list {
                list-style: none;
                margin: 0;
                padding: 0;
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .incident-list li {
                display: flex;
                gap: 12px;
                align-items: flex-start;
            }

            .incident-list a {
                color: var(--perch-fg);
                font-weight: 550;
                font-size: 15px;
            }

            .incident-list a:hover {
                color: var(--perch-accent);
            }

            .incident-list p {
                margin-top: 2px;
                color: var(--perch-fg-dim);
                font-size: 13px;
            }

            .none {
                color: var(--perch-fg-dim);
                font-size: 14px;
            }

            .foot {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                gap: 8px 24px;
                margin-top: 32px;
                color: var(--perch-fg-dim);
                font-size: 13px;
            }
        </style>
    </body>
</html>
